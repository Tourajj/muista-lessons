      "exampleEn": "They are not at home.",
      "note": "Negative form of olla with he (they).",
      "type": "grammar",
      "lesson": "Day 3"
    },
    {
      "id": "d3-vasynyt",
      "front": "väsynyt",
      "back": "tired",
      "exampleFi": "Oletko väsynyt?",
      "exampleEn": "Are you tired?",
      "note": "An adjective frequently used with olla.",
      "type": "vocabulary",
      "lesson": "Day 3"
    },
    {
      "id": "d3-nalkainen",
      "front": "nälkäinen",
      "back": "hungry",
      "exampleFi": "Minä olen nälkäinen.",
      "exampleEn": "I am hungry.",
      "note": "A useful everyday adjective.",
      "type": "vocabulary",
      "lesson": "Day 3"
    },
    {
      "id": "d4-minun",
      "front": "minun",
      "back": "my; of me",
      "exampleFi": "Minun nimeni on Leo.",
      "exampleEn": "My name is Leo.",
