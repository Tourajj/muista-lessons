  "cards": [
    {
      "id": "d3-en-ole",
      "front": "en ole",
      "back": "I am not",
      "exampleFi": "En ole väsynyt.",
      "exampleEn": "I am not tired.",
      "note": "Negative form of olla with minä (I).",
      "type": "grammar",
      "lesson": "Day 3"
    },
    {
      "id": "d3-et-ole",
      "front": "et ole",
      "back": "you are not (singular)",
      "exampleFi": "Et ole myöhässä.",
      "exampleEn": "You are not late.",
      "note": "Negative form of olla with sinä (you).",
      "type": "grammar",
      "lesson": "Day 3"
    },
    {
      "id": "d3-ei-ole",
      "front": "ei ole",
      "back": "he/she/it is not",
      "exampleFi": "Hän ei ole kotona.",
      "exampleEn": "He/she is not at home.",
      "note": "Negative form of olla with hän or se.",
      "type": "grammar",
      "lesson": "Day 3"
    },
    {
      "id": "d3-emme-ole",
      "front": "emme ole",
      "back": "we are not",
      "exampleFi": "Me emme ole valmiita.",
      "exampleEn": "We are not ready.",
      "note": "Negative form of olla with me (we).",
      "type": "grammar",
      "lesson": "Day 3"
    },
    {
      "id": "d3-ette-ole",
      "front": "ette ole",
      "back": "you are not (plural)",
      "exampleFi": "Te ette ole täällä.",
      "exampleEn": "You (plural) are not here.",
      "note": "Negative form of olla with te (you plural).",
      "type": "grammar",
      "lesson": "Day 3"
    },
    {
      "id": "d3-eivat-ole",
      "front": "eivät ole",
      "back": "they are not",
      "exampleFi": "He eivät ole kotona.",
      "exampleEn": "They are not at home.",
      "note": "Negative form of olla with he (they).",
      "type": "grammar",
      "lesson": "Day 3"
    },
    {
      "id": "d3-vasynyt",
      "front": "väsynyt",
      "back": "tired",
      "exampleFi": "Oletko väsynyt?",
      "exampleEn": "Are you tired?",
      "note": "An adjective frequently used with olla.",
      "type": "vocabulary",
      "lesson": "Day 3"
    },
    {
      "id": "d3-nalkainen",
      "front": "nälkäinen",
      "back": "hungry",
      "exampleFi": "Minä olen nälkäinen.",
      "exampleEn": "I am hungry.",
      "note": "A useful everyday adjective.",
      "type": "vocabulary",
      "lesson": "Day 3"
    },
    {
      "id": "d4-minun",
      "front": "minun",
      "back": "my; of me",
      "exampleFi": "Minun nimeni on Leo.",
      "exampleEn": "My name is Leo.",
      "note": "Genitive form of minä; standard possession may also require a possessive suffix.",
      "type": "grammar",
      "lesson": "Day 4"
    },
    {
      "id": "d4-sinun",
      "front": "sinun",
      "back": "your; of you",
      "exampleFi": "Mikä sinun nimesi on?",
      "exampleEn": "What is your name?",
      "note": "Genitive form of sinä.",
      "type": "grammar",
      "lesson": "Day 4"
    },
    {
      "id": "d4-minulle",
      "front": "minulle",
      "back": "to me; for me",
      "exampleFi": "Anna kirja minulle.",
      "exampleEn": "Give the book to me.",
      "note": "The -lle case often identifies a recipient.",
      "type": "grammar",
      "lesson": "Day 4"
    },
    {
      "id": "d4-sinulle",
      "front": "sinulle",
      "back": "to you; for you",
      "exampleFi": "Tämä on sinulle.",
      "exampleEn": "This is for you.",
      "note": "The -lle case often identifies a recipient.",
      "type": "grammar",
      "lesson": "Day 4"
    },
    {
      "id": "d4-nimi",
      "front": "nimi",
      "back": "name",
      "exampleFi": "Minun nimeni on Leo.",
      "exampleEn": "My name is Leo.",
      "note": "Standard: minun nimeni; common spoken: mun nimi.",
      "type": "vocabulary",
      "lesson": "Day 4"
    },
    {
      "id": "d4-kirja",
      "front": "kirja",
      "back": "book",
      "exampleFi": "Tämä on kirja.",
      "exampleEn": "This is a book.",
      "note": "Finnish has no articles a/an/the.",
      "type": "vocabulary",
      "lesson": "Day 4"
    },
    {
      "id": "d4-lahja",
      "front": "lahja",
      "back": "gift",
      "exampleFi": "Tämä lahja on sinulle.",
      "exampleEn": "This gift is for you.",
      "note": "Common with sinulle and minulle.",
      "type": "vocabulary",
      "lesson": "Day 4"
    },
    {
      "id": "d4-antaa",
      "front": "antaa",
      "back": "to give",
      "exampleFi": "Anna kirja minulle.",
      "exampleEn": "Give the book to me.",
      "note": "Anna is the singular imperative (give!), not a name in this sentence.",
      "type": "vocabulary",
      "lesson": "Day 4"
    },
    {
      "id": "d5-tama",
      "front": "tämä",
      "back": "this (one/thing)",
      "exampleFi": "Tämä on kirja.",
      "exampleEn": "This is a book.",
      "note": "Use tämä to identify something; it is not a word for 'in this place'.",
      "type": "grammar",
      "lesson": "Day 5"
    },
    {
      "id": "d5-tassa",
      "front": "tässä",
      "back": "here; in this exact spot",
      "exampleFi": "Tässä on kirja.",
      "exampleEn": "Here is a book.",
      "note": "Use tässä for something right here, often pointing to it.",
      "type": "grammar",
      "lesson": "Day 5"
    },
    {
      "id": "d5-taalla",
      "front": "täällä",
      "back": "here; in this area/place",
      "exampleFi": "Minä olen täällä.",
      "exampleEn": "I am here.",
      "note": "Use täällä for a broader place or area.",
      "type": "grammar",
      "lesson": "Day 5"
    },
    {
      "id": "d5-tama-on",
      "front": "Tämä on Anna.",
      "back": "This is Anna.",
      "exampleFi": "Hei! Tämä on Anna.",
      "exampleEn": "Hi! This is Anna.",
      "note": "Tämä on... introduces or identifies someone.",
      "type": "sentence",
      "lesson": "Day 5"
    },
    {
      "id": "d5-tassa-on",
      "front": "Tässä on Anna.",
      "back": "Here is Anna.",
      "exampleFi": "Tässä on Anna.",
      "exampleEn": "Here is Anna.",
      "note": "Tässä on... introduces someone who is here.",
      "type": "sentence",
      "lesson": "Day 5"
    },
    {
      "id": "d5-onko-taalla",
      "front": "Onko täällä kahvila?",
      "back": "Is there a café here?",
      "exampleFi": "Onko täällä kahvila?",
      "exampleEn": "Is there a café here?",
      "note": "Onko = is there? Täällä refers to this area.",
      "type": "sentence",
      "lesson": "Day 5"
    },
    {
      "id": "d5-mika-tama",
      "front": "Mikä tämä on?",
      "back": "What is this?",
      "exampleFi": "Mikä tämä on? Tämä on kirja.",
      "exampleEn": "What is this? This is a book.",
      "note": "Mikä = what; tämä = this.",
      "type": "sentence",
      "lesson": "Day 5"
    },
    {
      "id": "d5-tassa-kirja",
      "front": "Tässä on minun kirjani.",
      "back": "Here is my book.",
      "exampleFi": "Tässä on minun kirjani.",
      "exampleEn": "Here is my book.",
      "note": "Review: tässä (here), minun kirjani (my book).",
      "type": "sentence",
      "lesson": "Day 5"
    }
  ]
}
