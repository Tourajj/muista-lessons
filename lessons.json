      "type": "grammar",
      "lesson": "Day 4"
    },
    {
      "id": "d4-sinun",
      "front": "sinun",
      "back": "your; of you",
      "exampleFi": "Mikä sinun nimesi on?",
      "exampleEn": "What is your name?",
      "note": "Genitive form of sinä.",
      "type": "grammar",
      "lesson": "Day 4"
    },
    {
      "id": "d4-minulle",
      "front": "minulle",
      "back": "to me; for me",
      "exampleFi": "Anna kirja minulle.",
      "exampleEn": "Give the book to me.",
