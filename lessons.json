      "front": "en ole",
      "back": "I am not",
      "exampleFi": "En ole väsynyt.",
      "exampleEn": "I am not tired.",
      "note": "Negative form of olla with minä (I).",
      "type": "grammar",
      "lesson": "Day 3"
    },
    {
      "id": "d3-et-ole",
      "front": "et ole",
      "back": "you are not (singular)",
      "exampleFi": "Et ole myöhässä.",
      "exampleEn": "You are not late.",
      "note": "Negative form of olla with sinä (you).",
      "type": "grammar",
      "lesson": "Day 3"
    },
    {
      "id": "d3-ei-ole",
      "front": "ei ole",
      "back": "he/she/it is not",
      "exampleFi": "Hän ei ole kotona.",
      "exampleEn": "He/she is not at home.",
      "note": "Negative form of olla with hän or se.",
      "type": "grammar",
      "lesson": "Day 3"
    },
    {
      "id": "d3-emme-ole",
      "front": "emme ole",
